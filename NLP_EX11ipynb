      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "text = \"\"\n",
        "for paragraph in soup.find_all('p'):\n",
        "    text += paragraph.text"
      ],
      "metadata": {
        "collapsed": true,
        "id": "4IqYIrB6tGih"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "text = re.sub(r'\\[[0-9]*\\]',' ',text)\n",
        "text = re.sub(r'\\s+',' ',text)\n",
        "clean_text = text.lower()\n",
        "clean_text = re.sub(r'\\d',' ',clean_text)\n",
        "clean_text = re.sub(r'\\s+',' ',clean_text)\n"
      ],
      "metadata": {
